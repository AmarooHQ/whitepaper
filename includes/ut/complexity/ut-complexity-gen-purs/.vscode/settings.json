{
    // "purescript.addSpagoSources": true,
    // "purescript.addNpmPath": true,
    //"purescript.buildCommand": "spago build --purs-args --json-errors",
    "files.watcherExclude": {
        "**/.spago/**": true
    },
    "purescript.formatter": "purty",
    "editor.formatOnSave": false,
    "editor.trimAutoWhitespace": true,
    "files.autoSave": "onFocusChange",
    // "purescript.autocompleteAddImport": true,
    // "purescript.autocompleteGrouped": true,
    // "purescript.buildOpenedFiles": true,
    "purescript.fastRebuild": true,
    // "purescript.autocompleteAllModules": true,
    "purescript.censorWarnings": ["MissingTypeDeclaration", "WildcardInferredType"],
    "purescript.preludeModule": "Prel",
    "[purescript]": {
        "editor.tabSize": 2,
    },
    "workbench.panel.defaultLocation": "right",
    "output.smartScroll.enabled": true,
    "cSpell.enableFiletypes": [
        "purescript"
    ],
    "cSpell.words": [
        "verkle"
    ],
}
