digraph InitSimplex {
    //node [shape=point];

    p1 [pos = "10,10!"];
    p2 [pos = "20,20!"];

    p1 -> p2 [dir=none];
    p1 -> p3 [dir=none];
    p1 -> p4 [dir=none];
    p1 -> p5 [dir=none];
    p1 -> p6 [dir=none];

    p2 -> p3 [dir=none];
    p2 -> p4 [dir=none];
    p2 -> p5 [dir=none];
    p2 -> p6 [dir=none];

    p3 -> p4 [dir=none];
    p3 -> p5 [dir=none];
    p3 -> p6 [dir=none];

    p4 -> p5 [dir=none];
    p4 -> p6 [dir=none];

    p5 -> p6 [dir=none];
}
