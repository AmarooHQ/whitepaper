    powEngine [label = "PoW Engine"];
    // posEngine [label = "PoS/PoA Engine"];

    subgraph cluster_UtWhitePaper {
        // style=filled;
        // color=lightgrey;
        // node [style=filled];
        label = "UT WP Chapter";
        por [label = "Proof of Reflection"];
        simplex [label = "The Simplex"];
        simplex -> por;
        tiling [label="Simplex Tiling"];
        tiling -> simplex;
        dappChains [label = "Dappchains"];
        dappChains -> simplex;
    }

    subgraph cluster_FutureWp {
        label = "Future WP Chapters"
        networkTopol [label="Network Topology"]
        tokenomics [label="Tokenomics"];
        amarooVision [label="Vision and Details 2"];
