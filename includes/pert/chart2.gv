    tokenomics -> dappChains [lhead=cluster_UtWhitePaper]
    amarooVision -> dappChains [lhead=cluster_UtWhitePaper]
    amarooVision -> tiling [lhead=cluster_UtWhitePaper]
    networkTopol -> tiling [lhead=cluster_UtWhitePaper]

    basicP2P [label="MVP P2P Layer"]

    basicChain [label="MVP Chain"]
    basicChain -> powEngine
    basicChain -> basicP2P

    lightClient [label="Headers-only Mode"]
    lightClient -> basicChain

    basicState [label="MVP State impl"]

    basicProofs [label="MVP Merkle Branches"]
    basicProofs -> basicState

    basicPoR [label="MVP PoR impl"]
    basicPoR -> por
    // basicPoR -> basicChain
    basicPoR -> lightClient
    basicPoR -> basicProofs

    multichainP2P [label="Multi-chain P2P Layer"]
    multichainP2P -> basicP2P

    basic2Chains [label="MVP 1-Simplex"]
    basic2Chains -> basicPoR
    basic2Chains -> multichainP2P
    basicPoR -> simplex

    basicDappChain [label="MVP Dapp-Chain"]
    basicDappChain -> dappChains
    basicDappChain -> basicPoR
    basicDappChain -> multichainP2P

