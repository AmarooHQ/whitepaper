digraph TopicTree {
    compound=true;
    rankdir="LR";

    /* subgraph cluster_proofEngines {
        label = "Proof Engines";
        posEngine -> powEngine;
    } */

    /* subgraph cluster_whitePaper {
        // style=filled;
        // color=lightgrey;
