{
    "rules": {
        "en-max-word-count": {
            "max" : 40
        },
        "sentence-length": {
            "max": 250
        },
        "stop-words": {  // https://github.com/sapegin/textlint-rule-stop-words
            "defaultWords": false,
            "words": [
                ["dappchain"],
                ["dappchains"],
            ],
        }
    }
}
