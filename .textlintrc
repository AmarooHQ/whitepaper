{
    "rules": {
        "en-max-word-count": {
            "max" : 40
        },
        "sentence-length": {
            "max": 250
        },
        "stop-words": {  // https://github.com/sapegin/textlint-rule-stop-words
            "defaultWords": false,
            "words": [
                ["dappchain", "dapp-chain"],
                ["dappchains", "dapp-chains"],
                ["dapp chain", "dapp-chain"],
                ["dapp chains", "dapp-chains"],
                ["DApp", "dapp"],
                ["DApps", "dapps"],
                ["hte", "the"],
            ]
        }
    }
}
