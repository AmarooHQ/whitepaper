    "cSpell.ignoreWords": [
        "subsectionautorefname",
        "wordcount",
        "jobname",
        "texcount",
        "tcolorbox",
        "textit",
        "textbf",
        "textsc",
        "mathbb",
        "makeatletter",
        "makeatother",
        "graphicspath",
        "firststyle",
        "fancyhdr",
        "maxsColor",
        "colback",
        "coltext",
        "tocdepth",
        "endignore",
        "colbacktitle",
        "purescript",
        "spago",
        "purs",
        "papersize",
        "pandoc",
        "keepaspectratio",
        "algs",
        "\\textsc{ChainWeight}",
        "print-randhr-pmfs",
    ],
    "cSpell.minWordLength": 2,
    "cSpell.flagWords": [
        // add to .textlintrc.js too
        "hte", "DOS", "teh", "\\being{",
        "itertext", "the attackers", "DAA_N",
        "tress", "\\lable{", "lable",
        "tree tiling", "tree tilings",
        "dependant", "independant",
        "compromize", "compromized",
        "simplex chain"
    ],
    "cSpell.ignoreRegExpList": [
        "\\usepackage{([a-z,]*)}",
        "\\\\usepackage(\\[([a-z0-9,]*)\\])?{([a-z0-9,]*)}",
        "\\\\([a-z]*)",
        "\\\\(input|includegraphics)(\\[[a-z\\.\\\\=0-9]*\\])?{([a-z_A-Z/\\.0-9\\-]*)}",
        "\\\\(autoref|begin|end|label){([:a-z0-9\\-]*)}",
        "\\[\\^([a-z0-9\\-]*)\\]",
        "\\\\bquote{([a-zA-Z0-9`'\\- \\.;\\(\\)\\n]*)}",
        "[0-9][a-z]{0,2}",
        "it heavily relys on a symmetry",
        "online, nothing at stake is",
    ],
    "python.pythonPath": "/home/xertrov/.pyenv/versions/3.10.0b1/bin/python",
    "[rust]": {
        "editor.formatOnSave": true
    },
    "files.autoSave": "onFocusChange",
    "latex-workshop.view.pdf.viewer": "tab",
    // "latex-workshop.latex.autoBuild.run": "onFileChange",
    "latex-workshop.latex.pdfWatch.delay": 1000,
    "[latex]": {
        "editor.formatOnPaste": false,
        "editor.suggestSelection": "recentlyUsedByPrefix",
        "editor.wordWrap": "on"
    },
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-shell-escape",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.search.rootFiles.include": [
        "**/includes/**/*.tex",
    ],
    "latex-workshop.latex.autoBuild.interval": 1000,
    "latex-workshop.latex.watch.files.ignore": [
        "**/*.log",
        "**/*.bbx",
        "**/*.bbl",
        "**/*.cbx",
        "**/*.cfg",
        "**/*.clo",
        "**/*.cnf",
        "**/*.def",
        "**/*.dfu",
        "**/*.enc",
        "**/*.fd",
        "**/*.fmt",
        "**/*.lbx",
        "**/*.map",
        "**/*.mkii",
        "**/*.pfb",
        "**/*.tfm",
        "**/*.vf",
        "**/*.code.tex",
        "**/*.sty",
        "**/texmf-{dist,var}/**",
        "**/Local/MiKTeX/**",
        "**/Local/Programs/MiKTeX/**",
        "**/Roaming/MiKTeX/**",
        "**/Program*/MiKTeX*/**",
        "**/.miktex/texmfs/**",
        "/var/cache/miktex-texmf/**",
        "/usr/local/share/miktex-texmf/**",
        "**/Library/Application Support/MiKTeX/texmfs/**",
        "/dev/null",
        "output/**",
        "./output/*.tex",
        "./output/**/*.tex"
    ],
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "files.associations": {
        ".textlintrc": "jsonc"
    },
    "cSpell.enableFiletypes": [
        "latex",
        "tex"
    ],
    "gitlens.advanced.externalDiffTool": "meld",
    "makefile.configureOnOpen": true,
    "[markdown]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "other": true,
            "comments": true,
            "strings": true
        },
        "cSpell.fixSpellingWithRenameProvider": true,
        "cSpell.advanced.feature.useReferenceProviderWithRename": true,
        "cSpell.advanced.feature.useReferenceProviderRemove": "/^#+\\s/",
    }
}
